VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server only. Never expose this value through a VITE_ variable.
SUPABASE_SERVICE_ROLE_KEY=
OFFERPSP_PARSER_TOKEN=

# Modular platform nodes. Keep external nodes in shadow mode until audited.
OFFERPSP_DOCLING_MODE=off
DOCLING_URL=http://localhost:5001
DOCLING_API_KEY=
DOCLING_TIMEOUT_MS=45000

OFFERPSP_RULES_MODE=shadow

OFFERPSP_SEARCH_MODE=off
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=offerpsp_entities_v1

OFFERPSP_SEMANTIC_MEMORY_MODE=off
MEM0_API_KEY=
MEM0_HOST=
MEM0_PROFILE=BIXOFFPSP

VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Existing protected AIBot bridge. The SEO/GEO agent reuses its server-only authorization.
AIBOT_WEBHOOK_URL=
AIBOT_WEBHOOK_SECRET=
# Optional override. If omitted, the SEO agent URL is derived from AIBOT_WEBHOOK_URL.
OFFERPSP_SEO_AGENT_WEBHOOK_URL=
