{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/platform-modules.mjs": {
      "includeFiles": "rules/**"
    },
    "api/search-index-sync.mjs": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/search-index-sync",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/evaluate-rules",
      "destination": "/api/platform-modules?module=evaluate-rules"
    },
    {
      "source": "/api/module-health",
      "destination": "/api/platform-modules?module=module-health"
    },
    {
      "source": "/api/semantic-memory",
      "destination": "/api/platform-modules?module=semantic-memory"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
